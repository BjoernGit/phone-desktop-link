# Cloudflare Realtime TURN (optional)
# Created under dash.cloudflare.com -> Realtime -> TURN Server -> Create.
# When set, the server issues short-lived TURN credentials to clients so
# WebRTC can relay through Cloudflare when no direct P2P path exists.
# When unset, clients stay STUN-only and use the Socket.io fallback (30 MB).
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# Kill switch: set to "true" to stop issuing TURN credentials without
# removing the key (e.g. if relay traffic approaches the free tier limit).
TURN_DISABLED=false
