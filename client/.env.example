# Example environment variables for production deployment
# Copy this file to .env.local and adjust values as needed

# SSL Certificate paths (for local HTTPS development)
# VITE_SSL_CERT=./localhost+3.pem
# VITE_SSL_KEY=./localhost+3-key.pem

# Enable SSL in development
# VITE_DEV_SSL=1

# Enable local debug mode
# VITE_LOCAL_DEBUG=1

# Force WebRTC-only mode (no Socket.io fallback)
# Set to "true" to disable Socket.io fallback for file transfers
# Useful for testing WebRTC implementation locally
# Leave unset or set to "false" in production to allow Socket.io fallback
# VITE_FORCE_WEBRTC=false
